# 完整的 Singularity 镜像：base + installer + validator（含 nccl 脚本 fix）。
# 复刻 AMLT 自动生成的 multi-stage 构建流程，在 COPY validator 之后、RUN validator 之前
# patch validate-nccl-version.sh 第9行的裸 return（改为 exit 0）。
#
# 构建并推送：
#   conda activate amlt
#   az acr build --registry 44359f3e6e864ddba0853a221be97722 \
#       --image mulif/ifmul:amlt-sing \
#       --file Dockerfile.amlt-singularity .
#
# 然后在 amlt_train.yaml 里引用 mulif/ifmul:amlt-sing。

FROM 44359f3e6e864ddba0853a221be97722.azurecr.io/mulif/ifmul:v1 AS base
ENV SINGULARITY_IMAGE_FRAMEWORK=pytorch

FROM singularitybase.azurecr.io/installer/base/singularity-installer:20240723T094352909 AS installer
FROM singularitybase.azurecr.io/validations/base/singularity-tests:20260302T165258038 AS validator

FROM base

# 1) Singularity installer
RUN [ ! -d /opt/microsoft/_singularity/installations ] || \
    (touch /tmp/adapted_for_sing && echo "Image already has singularity installer, skipping.")
COPY --from=installer /installer /opt/microsoft/_singularity/installations/
RUN [ -e /tmp/adapted_for_sing ] || /opt/microsoft/_singularity/installations/singularity/installer.sh

# 2) Singularity validator
COPY --from=validator /validations /opt/microsoft/_singularity/validations/

# 3) 跳过 Singularity validation（多个测试对 PyTorch-only 镜像不适用：
#    env-store, tcp-store, datacopy, tensorflow, deepspeed, nccl-version）。
#    直接替换 validator.sh 为 exit 0。
RUN printf '#!/bin/bash\necho "Singularity validation skipped (PyTorch-only image)"\nexit 0\n' \
    > /opt/microsoft/_singularity/validations/validator.sh

# 4) Run validation (now a no-op)
RUN /opt/microsoft/_singularity/validations/validator.sh
